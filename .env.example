# ============================================================
# GRVT-Binance Grid Bots — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to version control.

# ============================================================
# Dashboard Auth
# ============================================================
DASHBOARD_API_KEY=change-me-to-a-random-secret
BOT_PORT=3849
LOG_LEVEL=info

# ============================================================
# GRVT Configuration
# ============================================================
# Network: testnet | mainnet
GRVT_ENV=testnet

# GRVT API credentials
# For GRVT, authentication is via Ethereum private key (EIP-712)
GRVT_PRIVATE_KEY=0x...
GRVT_API_KEY=...

# Optional: Override default GRVT endpoints
# GRVT_EDGE_URL=https://edge.testnet.grvt.io
# GRVT_MARKET_DATA_URL=https://market-data.testnet.grvt.io/full/v1
# GRVT_TRADING_URL=https://trades.testnet.grvt.io/full/v1

# ============================================================
# Binance Configuration
# ============================================================
# Network: testnet | mainnet
BINANCE_ENV=testnet

# Binance API credentials (HMAC-SHA256 signed requests)
# For production (USDC-margined Spot on Binance mainnet):
BINANCE_API_KEY=...
BINANCE_API_SECRET=...

# For Binance testnet (https://testnet.binance.vision):
BINANCE_TESTNET_API_KEY=...
BINANCE_TESTNET_SECRET_KEY=...

# Binance Spot base URLs (auto-selected by BINANCE_ENV)
# Binance testnet REST: https://testnet.binance.vision/api/v3
# Binance mainnet REST: https://api.binance.com/api/v3
# WebSocket testnet:    wss://testnet.binance.vision/ws
# WebSocket mainnet:    wss://stream.binance.com:9443/ws

# ============================================================
# Telegram Notifications (optional)
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TG_SCAN_INTERVAL_SECONDS=300
TG_EXPIRY_SECONDS=900
TG_MIN_SCORE=0.45
TG_COOLDOWN_HOURS=2

# ============================================================
# Trading Mode
# ============================================================
# paper  = simulated, no real orders
# testnet = real orders on testnet/exchange testnet
# live   = real orders with real money
TRADING_MODE=paper

# ============================================================
# Mailer (optional, for password reset)
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...
SMTP_FROM=noreply@example.com

# ============================================================
# Backtester
# ============================================================
# Number of hours of historical kline data to fetch for backtesting
BACKTEST_KLINE_LIMIT=1000